---
const cards=[{title:'Implantes dentários',desc:'Conheça possibilidades para substituir dentes ausentes com planejamento individualizado.',href:'/implantes/',image:'https://images.unsplash.com/photo-1609840114035-3c981b782dfe?auto=format&fit=crop&w=900&q=80',alt:'Ambiente odontológico moderno'},{title:'Próteses dentárias',desc:'Soluções protéticas pensadas para recuperar função, conforto e harmonia do sorriso.',href:'/proteses/',image:'https://images.unsplash.com/photo-1606811841689-23dfddce3e95?auto=format&fit=crop&w=900&q=80',alt:'Atendimento odontológico'},{title:'Ortodontia e Invisalign',desc:'Opções para alinhar o sorriso, com avaliação e acompanhamento profissional.',href:'/ortodontia/',image:'https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=900&q=80',alt:'Consultório odontológico'}];
---
<div class="services-grid">{cards.map(c=><article class="service-card"><div class="service-image" style={`background-image:url('${c.image}')`} role="img" aria-label={c.alt}></div><div class="service-body"><span class="eyebrow">Especialidade</span><h3>{c.title}</h3><p>{c.desc}</p><a class="text-link" href={c.href}>Conheça o tratamento ↗</a></div></article>)}</div>