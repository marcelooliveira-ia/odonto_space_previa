---
import '../styles/global.css';
const { title = 'ODONTO SPACE | Clínica odontológica em Bangu', description = 'Cuidado odontológico com atenção, tecnologia e planejamento em Bangu, Rio de Janeiro.', canonical = '', active = '' } = Astro.props;
const nav = [{label:'Início',href:'/'},{label:'Implantes',href:'/implantes/'},{label:'Próteses',href:'/proteses/'},{label:'Ortodontia',href:'/ortodontia/'},{label:'A clínica',href:'/clinica/'},{label:'Contato',href:'/contato/'}];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#159c9a" /><title>{title}</title>{canonical && <link rel="canonical" href={canonical} />}<slot name="head" /></head><body>
<header class="site-header"><div class="container nav"><a class="brand" href="/" aria-label="ODONTO SPACE - página inicial"><span class="brand-mark">✳</span><span>ODONTO SPACE</span></a><button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">☰</button><nav class="nav-links" aria-label="Navegação principal">{nav.map(n=><a href={n.href} aria-current={active===n.href?'page':undefined}>{n.label}</a>)}</nav><a class="btn small" href="/contato/">Agende uma avaliação <span>↗</span></a></div></header>
<main><slot /></main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="brand" href="/"><span class="brand-mark">✳</span><span style="color:white">ODONTO SPACE</span></a><p style="margin-top:18px;max-width:320px">Cuidado odontológico próximo, responsável e planejado para você.</p></div><div><h3>Explore</h3><a href="/implantes/">Implantes dentários</a><a href="/proteses/">Próteses dentárias</a><a href="/ortodontia/">Ortodontia e Invisalign</a><a href="/clinica/">A clínica</a></div><div><h3>Fale conosco</h3><a href="https://wa.me/5521996139234" target="_blank" rel="noopener">WhatsApp: (21) 99613-9234</a><a href="/contato/">Rua Francisco Real, 1910, sala 201</a><a href="/contato/">Bangu · Rio de Janeiro/RJ</a></div></div><div class="footer-bottom">© {new Date().getFullYear()} ODONTO SPACE. Protótipo de apresentação — informações institucionais sujeitas à validação.</div></div></footer>
<a class="whatsapp-float" href="https://wa.me/5521996139234?text=Olá!%20Gostaria%20de%20informações%20sobre%20atendimento." target="_blank" rel="noopener">WhatsApp ↗</a>
<script>const menu=document.querySelector('.menu-toggle');const links=document.querySelector('.nav-links');menu?.addEventListener('click',()=>{const open=links.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));menu.textContent=open?'×':'☰'});</script>
</body></html>